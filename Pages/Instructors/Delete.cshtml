@page "{id:int}"
@model SchoolManagement.Pages.Instructors.DeleteModel
@{
    ViewData["Title"] = "Delete Instructor";
}
<h1>Delete Instructor</h1>
<div class="alert alert-warning">Are you sure you want to delete this record? Related records may prevent deletion.</div>
<div class="card"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <dl class="row">
    <dt class="col-sm-3">InstructorID</dt><dd class="col-sm-9">@Model.Item.InstructorID</dd>
    <dt class="col-sm-3">First name</dt><dd class="col-sm-9">@Model.Item.FirstName</dd>
    <dt class="col-sm-3">Last name</dt><dd class="col-sm-9">@Model.Item.LastName</dd>
    <dt class="col-sm-3">Hire date</dt><dd class="col-sm-9">@Model.Item.HireDate.ToString("yyyy-MM-dd")</dd>
    </dl>
    <form method="post">
        <input type="hidden" name="id" value="@Model.Item.InstructorID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
