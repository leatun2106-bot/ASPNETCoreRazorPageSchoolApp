@page
@model SchoolManagement.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1>Departments</h1><p class="text-muted mb-0">View and manage departments records.</p></div>
    <a class="btn btn-primary" asp-page="Create">+ Create New</a>
</div>
<div class="card"><div class="card-body table-responsive">
<table class="table table-hover align-middle">
    <thead><tr><th>Department ID</th><th>Name</th><th>Budget</th><th>Start date</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td>@item.DepartmentID</td><td>@item.Name</td><td>@item.Budget.ToString("N2")</td><td>@item.StartDate.ToString("yyyy-MM-dd")</td><td class="text-nowrap">
            <a asp-page="Details" asp-route-id="@item.DepartmentID">Details</a> |
            <a asp-page="Edit" asp-route-id="@item.DepartmentID">Edit</a> |
            <a asp-page="Delete" asp-route-id="@item.DepartmentID">Delete</a>
        </td></tr>
    }
    </tbody>
</table>
@if (Model.Items.Count == 0) { <p class="text-muted mb-0">No records found.</p> }
</div></div>
