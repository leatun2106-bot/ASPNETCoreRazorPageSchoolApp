@page "{id:int}"
@model SchoolManagement.Pages.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
}
<h1>Edit Department</h1>
<div class="card"><div class="card-body">
<form method="post">
    <input type="hidden" asp-for="Item.DepartmentID" />
<div class="mb-3">
    <label asp-for="Item.Name" class="form-label">Name</label>
    <input asp-for="Item.Name" class="form-control" type="text" />
    <span asp-validation-for="Item.Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Item.Budget" class="form-label">Budget</label>
    <input asp-for="Item.Budget" class="form-control" type="number" step="0.01" />
    <span asp-validation-for="Item.Budget" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Item.StartDate" class="form-label">Start date</label>
    <input asp-for="Item.StartDate" class="form-control" type="date" />
    <span asp-validation-for="Item.StartDate" class="text-danger"></span>
</div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
