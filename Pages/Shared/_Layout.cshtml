<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f4f7fb; }
        .navbar { background: #123b66; }
        .navbar .navbar-brand, .navbar .nav-link { color: white; }
        .navbar .nav-link:hover { color: #bfe3ff; }
        .page-wrap { padding-top: 2rem; padding-bottom: 3rem; }
        .card { border: 0; box-shadow: 0 4px 16px rgba(20,50,80,.08); }
        h1 { color: #123b66; }
        .table thead th { background: #e8f1fb; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">School Management</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Students/Index">Students</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Courses/Index">Courses</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Instructors/Index">Instructors</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Enrollments/Index">Enrollments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Departments/Index">Departments</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container page-wrap">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
