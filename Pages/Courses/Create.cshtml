@page
@model SchoolManagement.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Create Course";
}
<h1>Create Course</h1>
<div class="card"><div class="card-body">
<form method="post">
<div class="mb-3">
    <label asp-for="Item.Title" class="form-label">Title</label>
    <input asp-for="Item.Title" class="form-control" type="text" />
    <span asp-validation-for="Item.Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Item.Credits" class="form-label">Credits</label>
    <input asp-for="Item.Credits" class="form-control" type="number" />
    <span asp-validation-for="Item.Credits" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Item.DepartmentID" class="form-label">Department</label>
    <select asp-for="Item.DepartmentID" class="form-select" asp-items="Model.DepartmentOptions"><option value="">-- Select department --</option></select>
    <span asp-validation-for="Item.DepartmentID" class="text-danger"></span>
</div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
