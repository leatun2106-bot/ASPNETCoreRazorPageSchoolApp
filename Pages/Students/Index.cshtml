@page
@model SchoolManagement.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1>Students</h1><p class="text-muted mb-0">View and manage students records.</p></div>
    <a class="btn btn-primary" asp-page="Create">+ Create New</a>
</div>
<div class="card"><div class="card-body table-responsive">
<table class="table table-hover align-middle">
    <thead><tr><th>Student ID</th><th>First name</th><th>Last name</th><th>Enrollment date</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td>@item.StudentID</td><td>@item.FirstName</td><td>@item.LastName</td><td>@item.EnrollmentDate.ToString("yyyy-MM-dd")</td><td class="text-nowrap">
            <a asp-page="Details" asp-route-id="@item.StudentID">Details</a> |
            <a asp-page="Edit" asp-route-id="@item.StudentID">Edit</a> |
            <a asp-page="Delete" asp-route-id="@item.StudentID">Delete</a>
        </td></tr>
    }
    </tbody>
</table>
@if (Model.Items.Count == 0) { <p class="text-muted mb-0">No records found.</p> }
</div></div>
